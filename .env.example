# PostHog (optional). Use a dedicated project for barbershop.wtf — not other products.
# Browser SDK expects a project key (phc_…), not a personal key (phx_…).
# Vite bakes these at build time; after setting them in Vercel, redeploy.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
